# Copie este arquivo para .env na raiz do repositorio.
# Valores de exemplo exclusivos para desenvolvimento local.
# Nome do banco e porta usada para acessa-lo pela sua maquina.
DB_NAME=conale
DB_PORT=3306
# Usuario do backend e sua senha
DB_USERNAME=conale
DB_PASSWORD=conale_local_dev
# Senha do administrador do MySQL.
DB_ROOT_PASSWORD=conale_root_local_dev
# Porta do backend no navegador: http://localhost:8080/actuator/health.
API_PORT=8080

# Para Spring Boot executado diretamente na maquina (IDE/Maven).
# Se alterar DB_NAME ou DB_PORT, atualize tambem esta URL.
DB_URL=jdbc:mysql://localhost:3306/conale?allowPublicKeyRetrieval=true&sslMode=DISABLED

# O Compose le .env para configurar o MySQL.
# Isso NAO exporta estas variaveis para Java/Maven/IDE automaticamente.
