<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- O Spring Boot define versoes compativeis para as dependencias. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.conAle</groupId>
    <artifactId>conale-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ConAle Backend</name>
    <!-- Versao Java da compilacao: deve acompanhar o JDK do Dockerfile. -->
    <properties>
        <java.version>24</java.version>
    </properties>
    <!-- Bibliotecas que o Maven baixa para construir a aplicacao. -->
    <dependencies>
        <!-- Servidor web e suporte a futuras rotas HTTP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Integra as futuras entidades Java com o banco. -->
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Disponibiliza a verificacao de saude da aplicacao. -->
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <!-- Controla quais migrations SQL ja foram aplicadas. -->
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <!-- Adiciona ao Flyway o suporte especifico ao MySQL. -->
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <!-- Driver que permite ao Java se conectar ao MySQL. -->
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Ferramentas usadas apenas para executar os testes. -->
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <!-- Nome do JAR que o Dockerfile copia para a imagem final. -->
        <finalName>conale-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <!-- Empacota a aplicacao para iniciar com java -jar. -->
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
