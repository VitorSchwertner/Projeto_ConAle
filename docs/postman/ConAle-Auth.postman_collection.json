{
  "info": {
    "name": "ConAle - Autenticação administrativa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preencha adminEmail e adminPassword localmente. Execute em ordem com cookies habilitados. Não exporte credenciais reais."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18081"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "noticiaId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Saúde",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Obter CSRF antes do login",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Senha não exposta\", () => { const b = pm.response.json(); pm.expect(b).not.to.have.property(\"senha\"); pm.expect(b).not.to.have.property(\"senhaHash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Renovar CSRF após login",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Administrador conectado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Criar notícia de teste",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Teste autenticado do Postman\",\n  \"sub_titulo\": \"Registro temporário\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/noticias"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"noticiaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Consultar notícia",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/noticias/{{noticiaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Editar notícia",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Notícia editada com sessão\",\n  \"sub_titulo\": \"Registro temporário\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/noticias/{{noticiaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Excluir notícia criada",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/noticias/{{noticiaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Criar segundo administrador de teste",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Administrador temporário Postman\",\n  \"email\": \"postman-{{$guid}}@example.invalid\",\n  \"senha\": \"SomenteTeste123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Consultar usuário criado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Editar usuário sem trocar senha",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Administrador temporário editado\",\n  \"email\": \"editado-{{$guid}}@example.invalid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Excluir usuário criado",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Confirmar fim da sessão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
