@startuml
title ConAle — Modelo de dados MySQL (V1 a V17)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam ArrowColor #526579
skinparam class {
  BackgroundColor #EDF7F3
  BorderColor #387D6A
}
hide circle

entity usuario {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * nome : VARCHAR(150)
  * email : VARCHAR(254) <<UNIQUE>>
  * senha_hash : VARCHAR(255)
  * administrador : BOOLEAN = FALSE
  * administrador_original : BOOLEAN = FALSE
}

entity banner {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * titulo : VARCHAR(150)
  * imagem : VARCHAR(500)
  imagem_mobile : VARCHAR(500)
  link : VARCHAR(500)
  posicao : VARCHAR(30)
  * ativo : BOOLEAN = TRUE
  posicao_ativa : VARCHAR(30) <<VIRTUAL, UNIQUE>>
}

entity noticia {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * titulo : VARCHAR(200)
  sub_titulo : VARCHAR(500)
}

entity indicador_institucional {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * anos_atuacao : INT
  * empresas_abertas : INT
}

entity mensagens_clientes {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * titulo : VARCHAR(150)
  * area_atuacao : VARCHAR(150)
  * nota : DOUBLE
  * mensagem : VARCHAR(1000)
}

entity rodape {
  * id : INT <<PK, AUTO_INCREMENT>>
  --
  * nome : VARCHAR(100) = 'Padrão'
  telefone : VARCHAR(20)
  instagram : VARCHAR(100)
  email : VARCHAR(254)
  link : VARCHAR(2048) <<LEGADO>>
  dias_semana : VARCHAR(100)
  horas_trabalhadas : VARCHAR(100)
  endereco : VARCHAR(255)
}

entity rodape_ativo {
  * id : INT <<PK, CHECK id = 1>>
  --
  * rodape_id : INT <<FK>>
}

entity link_site {
  * codigo : VARCHAR(50) <<PK>>
  --
  url : VARCHAR(500)
}

' As ligações ocultas organizam a leitura do modelo.
usuario -[hidden]right-> banner
banner -[hidden]right-> rodape
usuario -[hidden]down-> noticia
banner -[hidden]down-> indicador_institucional
noticia -[hidden]down-> mensagens_clientes
indicador_institucional -[hidden]down-> link_site

rodape ||--o| rodape_ativo : modelo selecionado

legend bottom
  O índice de usuario permite um único administrador original.
  O índice de banner limita a um banner ativo por posição não nula.
  Campos com asterisco são NOT NULL.
  PK = chave primária
  FK = chave estrangeira
endlegend
@enduml
