@startuml
title ConAle — Casos de uso da versão final
left to right direction
skinparam shadowing false
skinparam nodesep 18
skinparam defaultFontName Arial
skinparam ArrowColor #526579
skinparam usecase {
  BackgroundColor #EDF7F3
  BorderColor #387D6A
}
skinparam packageBorderColor #8DA5B8

actor Visitante
actor "Equipe da ConAle" as Equipe
actor Design
actor Administrador as Admin
actor "Administrador original" as Original
actor "Portal Onvio" as Onvio
actor "Google Maps" as Maps

Design --|> Equipe
Admin --|> Equipe
Original --|> Admin

rectangle "ConAle" {
  package "Site institucional" {
    usecase "UC01, UC02 e UC04\nNavegar e conhecer a ConAle" as Conhecer
    usecase "UC03\nConsultar serviços" as Servicos
    usecase "UC05\nLer avaliações de clientes" as Avaliacoes
    usecase "UC06 e UC15\nConsultar cards informativos" as Cards
    usecase "UC07\nAcessar contatos e links de atendimento" as Contatos
    usecase "UC07\nAbrir o endereço do rodapé no mapa" as Mapa
    usecase "UC08\nAcessar a Área do Cliente" as Cliente
  }

  package "Painel administrativo" {
    usecase "UC13\nEntrar, consultar sessão e sair" as Sessao
    usecase "UC09\nGerenciar avaliações de clientes" as EditarAvaliacoes
    usecase "UC10\nGerenciar banners, links,\nindicadores e rodapés" as EditarSite
    usecase "UC11\nGerenciar cards informativos" as EditarCards
    usecase "UC14\nRecortar e enviar imagens de banners" as Upload
    usecase "UC16\nGerenciar contas" as Usuarios
    usecase "UC16\nCriar administradores e alterar papéis" as Papeis
  }
}

Visitante -- Conhecer
Visitante -- Servicos
Visitante -- Avaliacoes
Visitante -- Cards
Visitante -- Contatos
Visitante -- Mapa
Visitante -- Cliente
Cliente -- Onvio
Mapa -- Maps

Equipe -- Sessao
Equipe -- EditarAvaliacoes
Equipe -- EditarSite
Equipe -- EditarCards
Equipe -- Upload
Admin -- Usuarios
Original -- Papeis

note right of Sessao
  A gestão exige sessão autenticada.
  Operações de escrita usam CSRF.
end note
@enduml
