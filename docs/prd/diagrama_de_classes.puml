@startuml
title ConAle — Classes da versão final
hide empty members
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam ArrowColor #526579
skinparam class {
  BackgroundColor #EDF7F3
  BorderColor #387D6A
}
skinparam packageBorderColor #8DA5B8

package "Entidades JPA" as Entidades {
  class Usuario {
    - id : Integer
    - nome : String
    - email : String
    - senhaHash : String
    - administrador : boolean
    - administradorOriginal : boolean
  }

  class Noticia {
    - id : Integer
    - titulo : String
    - subTitulo : String
  }

  class Banner {
    - id : Integer
    - titulo : String
    - imagem : String
    - imagemMobile : String
    - link : String
    - posicao : String
    - ativo : boolean
    + aceitaLink() : boolean
  }

  class IndicadorInstitucional {
    - id : Integer
    - anosAtuacao : int
    - empresasAbertas : int
  }

  class MensagensClientes {
    - id : Integer
    - titulo : String
    - areaAtuacao : String
    - nota : Double
    - mensagem : String
  }

  class Rodape {
    - id : Integer
    - nome : String
    - telefone : String
    - instagram : String
    - email : String
    - diasSemana : String
    - horasTrabalhadas : String
    - endereco : String
  }

  class RodapeAtivo {
    - id : Integer
    - rodapeId : Integer
  }
}

package "Classes de apoio" as Apoio {
  enum BannerFormato {
    HOME_TOPO
    SERVICOS_TOPO
    SOBRE_NOS
    AREA_CLIENTE
    SOBRE_MIM_FOTO
    + largura(mobile : boolean) : int
    + altura(mobile : boolean) : int
  }

  class ArquivoService {
    + salvarImagemBanner(...) : String
  }

  class LinkSiteService {
    + listar() : Map<String, String>
    + atualizar(links : Map<String, String>) : void
  }

  class DestinoPublico {
    {static} validar(valor : String) : String
  }
}

' As ligações ocultas organizam a leitura do diagrama.
Entidades -[hidden]down-> Apoio
Usuario -[hidden]right-> Banner
Banner -[hidden]right-> Noticia
Usuario -[hidden]down-> IndicadorInstitucional
Banner -[hidden]down-> MensagensClientes
Noticia -[hidden]down-> RodapeAtivo

RodapeAtivo ..> Rodape : referencia por ID
ArquivoService ..> BannerFormato : consulta o formato
LinkSiteService ..> DestinoPublico : valida o destino

legend bottom
  Noticia representa os Cards informativos no painel e no site.
  LinkSiteService lê e atualiza link_site com JdbcTemplate.
endlegend
@enduml
